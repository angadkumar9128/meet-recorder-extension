# CPU mode is automatic. Choose tiny, base, or small depending on RAM/speed.
WHISPER_MODEL=base
MEETNOTEBOOK_HOST=127.0.0.1
MEETNOTEBOOK_PORT=8765
MEETNOTEBOOK_MAX_UPLOAD_MB=2048

# Optional: accept the pyannote model terms on Hugging Face and create a read token.
# Without this, WhisperX still transcribes and aligns words, but speaker diarization is off.
HF_TOKEN=
