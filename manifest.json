{
  "manifest_version": 3,
  "name": "Meet Recorder + Speaker Transcript",
  "version": "1.1.0",
  "description": "Record Google Meet (video + audio) and save a speaker-labelled transcript.",
  "minimum_chrome_version": "116",
  "permissions": ["tabCapture", "offscreen", "downloads", "activeTab", "storage", "scripting"],
  "host_permissions": ["https://meet.google.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Meet Recorder" },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
